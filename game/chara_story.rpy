# ============================================================
# 角色剧情模块
# 结构：角色列表 → 各角色剧情线（按 chapter 顺序编号）
# 新增角色：① 在 screens.rpy 的 chara_story_list 里加按钮
#           ② 在此文件加对应 label，命名规范 ch_<角色拼音>_01
# ============================================================

# ---------- 角色好感/进度（按角色独立记录） ----------
default shiyi_trust = 0

# ---------- 角色列表入口 ----------
label chara_story_menu:
    call screen chara_story_list

    if _return == "shiyi":
        jump ch_shiyi_01
    else:
        jump mode_select

# ============================================================
# 仕衣 · 角色剧情
# 状态：占位，等待用户提供正式剧本后替换
# ============================================================
label ch_shiyi_01:
    scene black with fade
    n "【角色剧情 · 仕衣】"
    n "（本段为占位内容，等待接入正式剧本。）"
    call end_card("仕衣 · 角色剧情")
    jump chara_story_menu
